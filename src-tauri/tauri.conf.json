{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Webview Shell",
  "mainBinaryName": "webview-shell",
  "version": "0.1.1",
  "identifier": "com.arijumadi.webviewshell",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Productivity",
    "shortDescription": "Turn any URL into a desktop window",
    "longDescription": "A generic webview shell: point it at a URL via config file or CLI flags, with optional tray icon, autostart and global shortcut.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
